    "# ============================================================\n",
    "#  Pipeline de prétraitement complet\n",
    "# ============================================================\n",
    "\n",
    "def preprocess_tweet(text, emoji_mode='remove'):\n",
    "    \"\"\"\n",
    "    Pipeline complet de prétraitement pour un tweet darija.\n",
    "    \n",
    "    Ordre des opérations :\n",
    "    1. Vérification du type\n",
    "    2. Suppression URLs, mentions\n",
    "    3. Normalisation des hashtags\n",
    "    4. Gestion des emojis\n",
    "    5. Normalisation des caractères arabes\n",
    "    6. Normalisation des chiffres orientaux\n",
    "    7. Suppression des caractères de contrôle\n",
    "    8. Réduction des répétitions\n",
    "    9. Réduction ponctuation excessive\n",
    "    10. Nettoyage des espaces\n",
    "    \"\"\"\n",
    "    if pd.isna(text) or not isinstance(text, str):\n",
    "        return ''\n",
    "    \n",
    "    text = remove_urls(text)\n",
    "    text = remove_mentions(text)\n",
    "    text = normalize_hashtags(text)\n",
    "    text = handle_emojis(text, mode=emoji_mode)\n",
    "    text = normalize_arabic_chars(text)\n",
    "    text = normalize_eastern_digits(text)\n",
    "    text = remove_control_chars(text)\n",
    "    text = normalize_repeated_chars(text)\n",
    "    text = remove_punctuation_excess(text)\n",
    "    text = remove_extra_spaces(text)\n",
    "    \n",
    "    return text\n",
    "\n",
    "# Test sur quelques exemples\n",
    "tests = [\n",
    "    \"مممزيانننن هذا البرنامج https://t.co/abc @user123 😊😊😊\",\n",
    "    \"looooool wach raki??? #algérie\",\n",
    "    \"واش راك يا صحبي، tout va bien ?!!!\",\n",
    "    \"٣ jours seulement 💪💪💪 #darija\",\n",
    "]\n",
    "\n",
    "print(\"Tests du pipeline de prétraitement :\")\n",
    "print(\"=\" * 60)\n",
    "for t in tests:\n",
    "    print(f\"AVANT  : {t}\")\n",
    "    print(f\"APRÈS  : {preprocess_tweet(t)}\")\n",
    "    print(\"-\" * 60)"
   ]
