  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "#  2.4 — Split stratifié 70% / 15% / 15%\n",
    "#  ⚠️  À exécuter UNE SEULE FOIS — ne jamais modifier le test set\n",
    "# ============================================================\n",
    "\n",
    "X = df['text_clean'].values\n",
    "y = df[LABEL_COL].values\n",
    "\n",
    "# Étape 1 : séparer 70% train et 30% temp\n",
    "X_train, X_temp, y_train, y_temp, idx_train, idx_temp = train_test_split(\n",
    "    X, y, np.arange(len(df)),\n",
    "    test_size=0.30,\n",
    "    random_state=SEED,\n",
    "    stratify=y\n",
    ")\n",
    "\n",
    "# Étape 2 : séparer 50% / 50% du temp → 15% val + 15% test\n",
    "X_val, X_test, y_val, y_test, idx_val, idx_test = train_test_split(\n",
    "    X_temp, y_temp, idx_temp,\n",
    "    test_size=0.50,\n",
    "    random_state=SEED,\n",
    "    stratify=y_temp\n",
    ")\n",
    "\n",
    "print(\"=\" * 50)\n",
    "print(\"RÉSULTAT DU SPLIT\")\n",
    "print(\"=\" * 50)\n",
    "total = len(df)\n",
    "print(f\"  Train set : {len(X_train):>5} tweets ({len(X_train)/total*100:.1f}%)\")\n",
    "print(f\"  Val set   : {len(X_val):>5} tweets ({len(X_val)/total*100:.1f}%)\")\n",
    "print(f\"  Test set  : {len(X_test):>5} tweets ({len(X_test)/total*100:.1f}%)\")\n",
    "print(f\"  TOTAL     : {total} tweets\")"
   ]
