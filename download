    "## 2.1 Nettoyage de base"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "#  ÉTAPE 2.1 — Nettoyage de base\n",
    "# ============================================================\n",
    "\n",
    "def remove_urls(text):\n",
    "    \"\"\"Supprime les URLs (http://, https://, t.co/...).\"\"\"\n",
    "    return re.sub(r'https?://\\S+|www\\.\\S+', '', text)\n",
    "\n",
    "def remove_mentions(text):\n",
    "    \"\"\"Supprime les mentions (@utilisateur).\"\"\"\n",
    "    return re.sub(r'@\\w+', '', text)\n",
    "\n",
    "def normalize_hashtags(text):\n",
    "    \"\"\"Transforme #mot en mot (conserve le contenu sémantique).\"\"\"\n",
    "    return re.sub(r'#(\\w+)', r'\\1', text)\n",
    "\n",
    "def handle_emojis(text, mode='remove'):\n",
    "    \"\"\"\n",
    "    Gestion des emojis.\n",
    "    mode='remove'   → suppression complète (choix par défaut ici)\n",
    "    mode='keep'     → conserver les emojis tels quels\n",
    "    mode='replace'  → remplacer par leur description textuelle\n",
    "    \n",
    "    JUSTIFICATION (à inclure dans le rapport) :\n",
    "    Nous choisissons mode='remove' car DziriBERT n'a pas été entraîné sur des emojis\n",
    "    et leur tokenisation produit souvent des tokens UNK peu informatifs.\n",
    "    Cependant, l'analyse EDA (étape 1) a montré que les emojis sont corrélés au sentiment\n",
    "    → une alternative est de les remplacer par leur étiquette textuelle (mode='replace').\n",
    "    \"\"\"\n",
    "    try:\n",
    "        import emoji\n",
    "        if mode == 'remove':\n",
    "            return emoji.replace_emoji(text, replace='')\n",
    "        elif mode == 'replace':\n",
    "            return emoji.demojize(text, language='fr')  # ex: 😊 → :visage_souriant:\n",
    "        else:\n",
    "            return text\n",
    "    except ImportError:\n",
    "        # Fallback regex si emoji n'est pas installé\n",
    "        emoji_pattern = re.compile(\n",
    "            \"[\\U0001F600-\\U0001F64F\\U0001F300-\\U0001F5FF\"\n",
    "            \"\\U0001F680-\\U0001F6FF\\U0001F1E0-\\U0001F1FF\"\n",
    "            \"\\U00002702-\\U000027B0\\U000024C2-\\U0001F251]+\",\n",
    "            flags=re.UNICODE\n",
    "        )\n",
    "        return emoji_pattern.sub('', text)\n",
    "\n",
    "def remove_extra_spaces(text):\n",
    "    \"\"\"Supprime les espaces multiples et les espaces en début/fin.\"\"\"\n",
    "    return re.sub(r'\\s+', ' ', text).strip()\n",
    "\n",
    "print(\"Fonctions de nettoyage de base définies.\")"
   ]
