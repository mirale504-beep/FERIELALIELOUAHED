    "## 2.2 Normalisation spécifique au darija"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "#  ÉTAPE 2.2 — Normalisation spécifique au darija\n",
    "# ============================================================\n",
    "\n",
    "def normalize_arabic_chars(text):\n",
    "    \"\"\"\n",
    "    Normalise les variations orthographiques arabes courantes :\n",
    "    - أ إ آ → ا (alef)\n",
    "    - ة → ه (ta marbuta → ha)\n",
    "    - ى → ي (alef maqsura → ya)\n",
    "    - Suppression des diacritiques (tashkeel)\n",
    "    \"\"\"\n",
    "    # Normalisation de l'alef (variations avec hamza)\n",
    "    text = re.sub(r'[أإآ]', 'ا', text)\n",
    "    # Ta marbuta → ha (optionnel selon le corpus — à tester)\n",
    "    # text = re.sub(r'ة', 'ه', text)\n",
    "    # Alef maqsura → ya\n",
    "    text = re.sub(r'ى', 'ي', text)\n",
    "    # Suppression des diacritiques arabes (harakat, shadda, etc.)\n",
    "    text = re.sub(r'[\\u064B-\\u065F\\u0670]', '', text)\n",
    "    # Suppression des tatweel (ـ) — allongement décoratif\n",
    "    text = re.sub(r'\\u0640', '', text)\n",
    "    return text\n",
    "\n",
    "def normalize_repeated_chars(text):\n",
    "    \"\"\"\n",
    "    Réduit les répétitions de caractères à 2 occurrences maximum.\n",
    "    Exemple : مزيانننن → مزياننن → مزيانن | looooool → lool\n",
    "    \n",
    "    JUSTIFICATION : les répétitions sont un marqueur d'intensité émotionnelle\n",
    "    dans le darija (et en Arabizi) mais créent un vocabulaire trop fragmenté.\n",
    "    On réduit à 2 pour préserver le signal d'intensité tout en normalisant.\n",
    "    \"\"\"\n",
    "    return re.sub(r'(.)\\1{2,}', r'\\1\\1', text)\n",
    "\n",
    "def normalize_eastern_digits(text):\n",
    "    \"\"\"\n",
    "    Convertit les chiffres arabes orientaux (٠١٢...) en chiffres occidentaux (012...).\n",
    "    \"\"\"\n",
    "    eastern = '٠١٢٣٤٥٦٧٨٩'\n",
    "    western = '0123456789'\n",
    "    trans = str.maketrans(eastern, western)\n",
    "    return text.translate(trans)\n",
    "\n",
    "def remove_control_chars(text):\n",
    "    \"\"\"Supprime les caractères de contrôle invisibles (RTL marks, etc.).\"\"\"\n",
    "    return re.sub(r'[\\u200b-\\u200f\\u202a-\\u202e\\ufeff]', '', text)\n",
    "\n",
    "def remove_punctuation_excess(text):\n",
    "    \"\"\"\n",
    "    Réduit la ponctuation répétée (!!!! → !!, ??? → ??).\n",
    "    Conserve 1-2 signes pour préserver l'expressivité.\n",
    "    \"\"\"\n",
    "    text = re.sub(r'([!?.]){3,}', r'\\1\\1', text)\n",
    "    return text\n",
    "\n",
    "print(\"Fonctions de normalisation darija définies.\")"
   ]
