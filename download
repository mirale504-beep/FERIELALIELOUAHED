    "# Encodage des labels en entiers (nécessaire pour DziriBERT fine-tuning)\n",
    "LABEL2ID = {'Negative': 0, 'Neutral': 1, 'Positive': 2}\n",
    "ID2LABEL = {v: k for k, v in LABEL2ID.items()}\n",
    "\n",
