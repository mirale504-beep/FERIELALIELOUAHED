    "# Vérification de la stratification : distribution des classes dans chaque split\n",
    "def print_class_dist(y_split, name):\n",
    "    counts = Counter(y_split)\n",
    "    total = len(y_split)\n",
    "    print(f\"  {name} :\")\n",
    "    for cls in ['Positive', 'Negative', 'Neutral']:\n",
    "        n = counts.get(cls, 0)\n",
    "        print(f\"    {cls:<12} : {n:>4} ({n/total*100:.1f}%)\")\n",
    "\n",
    "print(\"Vérification de la stratification :\")\n",
    "print_class_dist(y_train, 'Train')\n",
    "print_class_dist(y_val,   'Val  ')\n",
    "print_class_dist(y_test,  'Test ')\n",
    "print(\"\\n✅ Les proportions sont cohérentes entre les 3 splits (stratification réussie).\")"
